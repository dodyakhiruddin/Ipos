{
  "name": "DONET CELL - Kasir",
  "short_name": "DONET CELL",
  "description": "Aplikasi kasir, pembelian, penjualan, PPOB & BRILink",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#d8e6f3",
  "theme_color": "#0b2557",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [ { "name": "bukti", "accept": ["image/*"] } ]
    }
  }
}
